{
    "manifest_version": 3,
    "name": "Autocom",
    "version": "1.0",
    "description": "Simple Chrome extension with content script",
    "author": "Lordskey",
  
    "action": {
      "default_popup": "popup.html",
      "default_icon": "assets/icon.png"
    },
  
    "background": {
      "service_worker": "background.js"
    },

  "web_accessible_resources": [
    {
      "resources": ["usernames.json","user_images/*","/assets/libs/q.js","content.js", "assits.js", "ui.js","l.jpg"],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  

    "permissions": [
      "storage",
      "activeTab",
      "scripting",
      "clipboardWrite"
    ],

    
  
    "content_scripts": [
      {
        "matches": [
          "https://www.tumblr.com/index"
        ],
        "js":   ["/assets/libs/q.js","content-loader.js"],
        "css":  ["/assets/owl_style.css"],
        "resources": ["usernames.json"],
        "run_at": "document_idle"
      }
    ]
  }
